{
  "name": "sort",
  "doc": "sort lines (numeric, reverse, unique) as Datalog-backed rows",
  "usage": "usage: fx-sort [OPTIONS] [FILE]",
  "args": [
    {"field": "input", "type": "Text", "default": "\"\"", "positional": { "display":"FILE", "many":false }, "flags": []},
    {"field": "numeric", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-n", "long": "--numeric-sort", "kind": "Flag", "value": null } ]},
    {"field": "reverse", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-r", "long": "--reverse", "kind": "Flag", "value": null } ]},
    {"field": "unique", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-u", "long": "--unique", "kind": "Flag", "value": null } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "sum",
  "doc": "print checksum and block count for each FILE (-s SysV)",
  "usage": "usage: fx-sum [OPTIONS] [FILE...]",
  "args": [
    {"field": "files", "type": "List Text", "default": "[] : List Text", "positional": { "display":"FILE", "many":true }, "flags": []},
    {"field": "sysv", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-s", "long": "--sysv", "kind": "Flag", "value": null } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "tail",
  "doc": "print the last N lines (-n, default 10) of FILEs (or stdin)",
  "usage": "usage: fx-tail [OPTIONS] [FILE]",
  "args": [
    {"field": "input", "type": "Text", "default": "\"\"", "positional": { "display":"FILE", "many":false }, "flags": []},
    {"field": "n", "type": "Natural", "default": "10", "positional": null, "flags": [ { "short": "-n", "long": "--lines", "kind": "Value", "value": null } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "tee",
  "doc": "copy stdin to each FILE and to stdout (-a appends)",
  "usage": "usage: fx-tee [OPTIONS] [FILE...]",
  "args": [
    {"field": "append", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-a", "long": "--append", "kind": "Flag", "value": null } ]},
    {"field": "files", "type": "List Text", "default": "[] : List Text", "positional": { "display":"FILE", "many":true }, "flags": []}
  ],
  "mutually_exclusive": []
},
{
  "name": "top",
  "doc": "single-shot process ranking by total cpu ticks or memory",
  "usage": "usage: fx-top [OPTIONS]",
  "args": [
    {"field": "count", "type": "Natural", "default": "15", "positional": null, "flags": [ { "short": "-n", "long": null, "kind": "Value", "value": null } ]},
    {"field": "rows", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": null, "long": "--rows", "kind": "Flag", "value": null } ]},
    {"field": "sort", "type": "< Cpu | Mem >", "default": "< Cpu | Mem >.Cpu", "positional": null, "flags": [ { "short": "-m", "long": null, "kind": "Enum", "value": "Mem" } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "touch",
  "doc": "create files or update timestamps, journaled",
  "usage": "usage: fx-touch [FILE...]",
  "args": [
    {"field": "files", "type": "List Text", "default": "[] : List Text", "positional": { "display":"FILE", "many":true }, "flags": []}
  ],
  "mutually_exclusive": []
},
{
  "name": "tree",
  "doc": "render a directory closure as a tree (Datalog descent)",
  "usage": "usage: fx-tree [OPTIONS] [ROOT]",
  "args": [
    {"field": "all", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-a", "long": "--all", "kind": "Flag", "value": null } ]},
    {"field": "dirs_only", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-d", "long": "--dirs-only", "kind": "Flag", "value": null } ]},
    {"field": "maxdepth", "type": "Optional Natural", "default": "None Natural", "positional": null, "flags": [ { "short": "-L", "long": null, "kind": "Value", "value": null } ]},
    {"field": "root", "type": "Text", "default": "\".\"", "positional": { "display":"ROOT", "many":false }, "flags": []},
    {"field": "rows", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": null, "long": "--rows", "kind": "Flag", "value": null } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "truncate",
  "doc": "shrink or extend a file to SIZE (-r REF), CAS-captured",
  "usage": "usage: fx-truncate [OPTIONS] [FILE...]",
  "args": [
    {"field": "files", "type": "List Text", "default": "[] : List Text", "positional": { "display":"FILE", "many":true }, "flags": []},
    {"field": "no_create", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-c", "long": "--no-create", "kind": "Flag", "value": null } ]},
    {"field": "ref", "type": "Optional Text", "default": "None Text", "positional": null, "flags": [ { "short": "-r", "long": "--reference", "kind": "Value", "value": null } ]},
    {"field": "size", "type": "Optional Text", "default": "None Text", "positional": null, "flags": [ { "short": "-s", "long": "--size", "kind": "Value", "value": null } ]}
  ],
  "mutually_exclusive": [["-s","-r"]]
},
{
  "name": "uname",
  "doc": "print system information (-a: all)",
  "usage": "usage: fx-uname [OPTIONS]",
  "args": [
    {"field": "all", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-a", "long": "--all", "kind": "Flag", "value": null } ]},
    {"field": "kernel", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-s", "long": "--kernel-name", "kind": "Flag", "value": null } ]},
    {"field": "machine", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-m", "long": "--machine", "kind": "Flag", "value": null } ]},
    {"field": "nodename", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-n", "long": "--nodename", "kind": "Flag", "value": null } ]},
    {"field": "os", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-o", "long": "--operating-system", "kind": "Flag", "value": null } ]},
    {"field": "release", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-r", "long": "--release", "kind": "Flag", "value": null } ]},
    {"field": "version", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-v", "long": null, "kind": "Flag", "value": null } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "uniq",
  "doc": "filter repeated adjacent lines in sorted input (-c counts)",
  "usage": "usage: fx-uniq [OPTIONS] [FILE]",
  "args": [
    {"field": "count", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-c", "long": "--count", "kind": "Flag", "value": null } ]},
    {"field": "global", "type": "Bool", "default": "False", "positional": null, "flags": [ { "short": "-g", "long": "--global", "kind": "Flag", "value": null } ]},
    {"field": "input", "type": "Text", "default": "\"\"", "positional": { "display":"FILE", "many":false }, "flags": []}
  ],
  "mutually_exclusive": []
},
{
  "name": "unlink",
  "doc": "delete a name and possibly the file it refers to",
  "usage": "usage: fx-unlink [PATH]",
  "args": [
    {"field": "path", "type": "Text", "default": "\"\"", "positional": { "display":"PATH", "many":false }, "flags": []}
  ],
  "mutually_exclusive": []
},
{
  "name": "wc",
  "doc": "print newline, word and byte counts for each FILE",
  "usage": "usage: fx-wc [FILE]",
  "args": [
    {"field": "input", "type": "Text", "default": "\"\"", "positional": { "display":"FILE", "many":false }, "flags": []}
  ],
  "mutually_exclusive": []
},
{
  "name": "what",
  "doc": "query which package owns a rootfs PATH (provenance)",
  "usage": "usage: fx-what [OPTIONS] [PATH]",
  "args": [
    {"field": "as_of", "type": "Optional Natural", "default": "None Natural", "positional": null, "flags": [ { "short": null, "long": "--as-of", "kind": "Value", "value": null } ]},
    {"field": "operand", "type": "Text", "default": "\"\"", "positional": { "display":"PATH", "many":false }, "flags": []},
    {"field": "store", "type": "Optional Text", "default": "None Text", "positional": null, "flags": [ { "short": null, "long": "--store", "kind": "Value", "value": null } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "whoami",
  "doc": "print the effective user name",
  "usage": "usage: fx-whoami",
  "args": [
    {"field": "nothing", "type": "Bool", "default": "True", "positional": null, "flags": []}
  ],
  "mutually_exclusive": []
},
{
  "name": "why",
  "doc": "explain why a package is in the store (provenance)",
  "usage": "usage: fx-why [OPTIONS] [PKG]",
  "args": [
    {"field": "as_of", "type": "Optional Natural", "default": "None Natural", "positional": null, "flags": [ { "short": null, "long": "--as-of", "kind": "Value", "value": null } ]},
    {"field": "operand", "type": "Text", "default": "\".\"", "positional": { "display":"PKG", "many":false }, "flags": []},
    {"field": "store", "type": "Optional Text", "default": "None Text", "positional": null, "flags": [ { "short": null, "long": "--store", "kind": "Value", "value": null } ]}
  ],
  "mutually_exclusive": []
},
{
  "name": "yes",
  "doc": "repeatedly output STRING (or 'y'), one per line, until killed",
  "usage": "usage: fx-yes [STRING...]",
  "args": [
    {"field": "strings", "type": "List Text", "default": "[] : List Text", "positional": { "display":"STRING", "many":true }, "flags": []}
  ],
  "mutually_exclusive": []
}
]
}
